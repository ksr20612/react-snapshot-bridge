{
  "name": "react-snapshot-bridge",
  "version": "1.1.0",
  "description": "Use React's class-only `getSnapshotBeforeUpdate` lifecycle from **function components**.",
  "keywords": [
    "react",
    "getSnapshotBeforeUpdate",
    "lifecycle",
    "snapshot",
    "hooks",
    "useLayoutEffect",
    "before-mutation"
  ],
  "author": {
    "name": "ksr20612",
    "url": "https://github.com/ksr20612"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ksr20612/react-snapshot-bridge.git",
    "directory": "packages/react-snapshot-bridge"
  },
  "homepage": "https://react-snapshot-bridge.vercel.app",
  "bugs": {
    "url": "https://github.com/ksr20612/react-snapshot-bridge/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=16.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

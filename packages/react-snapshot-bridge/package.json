{
  "name": "react-snapshot-bridge",
  "version": "0.1.0",
  "description": "Alternative GetSnapshotBeforeUpdate Hook for React Functional Components",
  "keywords": [
    "react",
    "getSnapshotBeforeUpdate",
    "lifecycle",
    "snapshot",
    "hooks",
    "useLayoutEffect",
    "before-mutation"
  ],
  "author": "ksr20612",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ksr20612/react-snapshot-bridge.git",
    "directory": "packages/react-snapshot-bridge"
  },
  "homepage": "https://github.com/ksr20612/react-snapshot-bridge#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=16.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

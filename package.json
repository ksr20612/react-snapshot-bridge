{
  "name": "react-snapshot-bridge-repo",
  "private": true,
  "version": "0.0.0",
  "description": "Use React's class-only `getSnapshotBeforeUpdate` lifecycle from function components.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter docs build",
    "build:lib": "pnpm --filter \"./packages/*\" build",
    "build:docs": "pnpm --filter docs build",
    "test": "pnpm --filter \"./packages/*\" test",
    "typecheck": "pnpm --filter \"./packages/*\" -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "typescript": "^5.7.2"
  }
}
